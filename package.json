{
  "name": "babu-app-uninstaller",
  "version": "1.0.0",
  "description": "A safe macOS app uninstaller",
  "main": "dist-electron/main.cjs",
  "author": "Babu Studios",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:127.0.0.1:5173 && npm run build:electron && VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "npm run typecheck && vite build && npm run build:electron",
    "build:electron": "esbuild electron/main.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/main.cjs && esbuild electron/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/preload.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.renderer.json && tsc --noEmit -p tsconfig.electron.json && tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run --config vitest.config.ts",
    "approve-scripts": "npm install-scripts approve esbuild electron",
    "rebuild:electron": "npm rebuild esbuild && node node_modules/electron/install.js",
    "icon": "node scripts/create-icon.mjs",
    "dist": "npm run build && npm run icon && electron-builder --mac dmg --arm64 --x64"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "plist": "^3.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/plist": "^3.0.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.1.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.babu.appuninstaller",
    "productName": "Babu App Uninstaller",
    "asar": true,
    "files": [
      "dist/**",
      "dist-electron/**"
    ],
    "directories": {
      "output": "release"
    },
    "afterPack": "electron/after-pack.cjs",
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities",
      "icon": "build/icon.icns",
      "identity": null,
      "extendInfo": {
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Application bundle",
            "CFBundleTypeExtensions": [
              "app"
            ],
            "LSItemContentTypes": [
              "com.apple.application-bundle"
            ],
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate"
          }
        ]
      }
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "electron@44.9.0": true
  }
}
